package "monitoring.application" {
  class useMonitoringStore {
    - readings
    - offlineReadings
    - incidents
    - maintenanceSchedules
    - technicalServiceRequests
    + fetchMonitoringData(options)
    + createSensorReading(sensorReading)
    + getLatestTemperatureByAsset(assetId)
    + getLatestHumidityByAsset(assetId)
    + getReadingsByAsset(assetId, from, to)
    + recentReadingsForAssetIds(assetIds, limit)
    + syncReading(id)
    + syncAllPending()
    + syncGeneratedIncidentsForOrganization(organizationId)
    + updateOrganizationTelemetry(organizationId)
    + hasCalibrationIssue(iotDevice)
  }
}

