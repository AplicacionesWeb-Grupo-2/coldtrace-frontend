package "alerts.domain.model" {
  class EscalationPolicy {
    - severity: string
    - waitingMinutes: Number
    - level: Number
    - targetKey: string
    + appliesTo(incident): Boolean
  }
  class "Incident" as AlertsIncident {
    - id: Number
    - organizationId: Number
    - assetId: Number
    - assetName: string
    - type: string
    - severity: string
    - status: string
    - conditionStable: Boolean
    - escalationStatus: string
    + isOpen
    + isRecognized
    + isClosed
    + isConditionStable
    + isGenerated
    + isPendingReview
    + isEscalated
  }
  class Notification {
    - id: Number
    - organizationId: Number
    - incidentId: Number
    - assetName: string
    - channel: NotificationChannel
    - recipient: string
    - status: NotificationStatus
    + isPending
    + isSent
    + isFailed
  }
  class NotificationChannel <<enumeration>>
  class NotificationStatus <<enumeration>>
}

package "alerts.infrastructure" {
  class AlertsApi {
    - incidentsEndpoint: BaseEndpoint
    - notificationsEndpoint: BaseEndpoint
    + getIncidents()
    + createIncident(resource)
    + updateIncident(resource)
    + getNotifications()
    + createNotification(resource)
