    + getIncidents()
    + createIncident(resource)
    + updateIncident(id, resource)
    + getMaintenanceSchedules()
    + getTechnicalServiceRequests()
  }
  class SensorReadingAssembler
  class "IncidentAssembler" as MonitoringIncidentAssembler
  class "MaintenanceScheduleAssembler" as MonitoringMaintenanceScheduleAssembler
  class "TechnicalServiceRequestAssembler" as MonitoringTechnicalServiceRequestAssembler
