    + closeIncident(incident, correctiveAction, evidence, userName)
    + stabilizeIncident(incident)
    + reviewEscalation(incident, userName)
    + canResolveAlerts()
    + setFeedback(feedback)
    + clearFeedback()
  }
}

package "alerts.presentation.views" {
