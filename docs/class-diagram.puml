@startuml

skinparam packageStyle rectangle
hide empty members

package "root" {
  class App
  class Router {
    + routes
    + beforeEach()
  }
  class I18n {
    + en
    + es
  }
  class Pinia
}

package "shared.infrastructure" {
  class BaseApi {
    - http
    + http
  }
  class BaseEndpoint {
    - http
    - endpointPath
    + getAll()
    + getById(id)
    + create(resource)
    + update(id, resource)
    + delete(id)
    + requestItem(method, id, data)
    + collectionFallbackResponse(response)
    + shouldUseCollectionFallback(response, fallbackResponse)
    + fallbackBaseURL()
    + requestCollectionWrite(method, data)
  }
}

package "shared.presentation.components" {
  class DashboardShell {
    - accessDropdownOpen: Boolean
    - reportsDropdownOpen: Boolean
    - settingsDropdownOpen: Boolean
    + toggleAccessDropdown(): void
    + toggleReportsDropdown(): void
    + toggleSettingsDropdown(): void
    + logout(): void
    + loadShellData(): Promise
    + startTelemetryUpdates(): void
    + downloadCurrentMonthReport(): Promise
  }
  class LanguageSwitcher {
    - options
    + setLanguage(value): void
  }
  class Layout {
    - dashboardRoutePaths
    - showDashboardShell: Boolean
    - showLanguageSwitcher: Boolean
  }
  class ListPagination {
    - total: Number
    - pageSize: Number
    - modelValue: Number
    + update:modelValue(): void <<event>>
    + goToPage(page): void
  }
}

package "shared.presentation.views" {
  class PageNotFound
}

package "identity-access.domain.model" {
  class Organization {
    - id: Number
    - legalName: string
    - commercialName: string
    - taxId: string
    - contactEmail: string
  }
  class Permission {
    - id: Number
    - resource: string
    - action: string
    - description: string
  }
  class Role {
    - id: Number
    - name: string
    - label: string
    - permissions: Permission[]
  }
  class RoleName <<enumeration>> {
    SuperAdministrator
    Administrator
    OperationsManager
    Operator
    Auditor
  }
  class User {
    - id: Number
    - uuid: string
    - organizationUserId: Number
    - firstName: string
    - lastName: string
    - email: string
    - organizationId: Number
    - roleId: Number
    + fullName
  }
}

package "identity-access.infrastructure" {
  class IdentityAccessApi {
    - usersEndpoint: BaseEndpoint
    - organizationsEndpoint: BaseEndpoint
    - rolesEndpoint: BaseEndpoint
    + getUsers()
    + createUser(resource)
    + updateUser(resource)
    + deleteUser(id)
    + getOrganizations()
    + createOrganization(resource)
    + getRoles()
    + updateRole(resource)
  }
  class UserAssembler {
    + toEntityFromResource(resource)
    + toEntitiesFromResponse(response)
    + toResourceFromEntity(entity)
  }
  class OrganizationAssembler {
    + toEntityFromResource(resource)
    + toEntitiesFromResponse(response)
    + toResourceFromEntity(entity)
  }
  class RoleAssembler {
    + toEntityFromResource(resource)
    + toEntitiesFromResponse(response)
    + toResourceFromEntity(entity)
  }
}

package "identity-access.application" {
  class useIdentityAccessStore {
    - users
    - organizations
    - roles
    - currentUser
    - currentOrganization
    - currentRole
    + fetchAccessData()
    + signIn(email, password)
    + createAccount(payload)
    + createOrganizationUser(payload)
    + updateUserRole(user, roleId)
    + deleteUser(user)
    + toggleRolePermission(role, permissionKey, checked)
    + canManageAccess()
    + canManageUsers()
    + canManageAssets()
    + canMonitorAssets()
  }
}

package "identity-access.presentation.views" {
  class SignIn {
    - form
    - feedback
    + submit(): Promise
  }
  class SignUp {
    - form
    - feedback
    + submit(): Promise
  }
  class PasswordRecovery
  class ResetPassword
  class UserAccessList {
    - searchTerm
    - currentPage
    + updateUserRole(): Promise
    + deleteUser(): Promise
  }
  class UserForm {
    - form
    + submit(): Promise
  }
  class RolePermissionForm {
    - savingRoleId
    + toggleRolePermission(role, permissionKey, checked): Promise
  }
}

package "identity-access.presentation" {
  class IdentityAccessRoutes {
    + dashboard
    + passwordRecovery
    + resetPassword
    + rolesPermissions
    + userNew
    + signIn
    + signUp
