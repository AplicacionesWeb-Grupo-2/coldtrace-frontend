' Identity relationships
User --> Organization : belongs to
User --> Role : has
Role --> Permission : contains
Role ..> RoleName : uses
IdentityAccessApi --|> BaseApi
IdentityAccessApi *-- BaseEndpoint
UserAssembler ..> User : creates
OrganizationAssembler ..> Organization : creates
RoleAssembler ..> Role : creates
RoleAssembler ..> Permission : creates
useIdentityAccessStore ..> IdentityAccessApi : uses
useIdentityAccessStore ..> UserAssembler : uses
useIdentityAccessStore ..> OrganizationAssembler : uses
useIdentityAccessStore ..> RoleAssembler : uses
useIdentityAccessStore ..> RoleName : enforces
SignIn ..> useIdentityAccessStore : uses
SignUp ..> useIdentityAccessStore : uses
UserAccessList ..> useIdentityAccessStore : uses
UserForm ..> useIdentityAccessStore : uses
RolePermissionForm ..> useIdentityAccessStore : uses
RolePermissionForm --> ListPagination : uses
UserAccessList --> ListPagination : uses
IdentityAccessRoutes --> SignIn : maps
IdentityAccessRoutes --> SignUp : maps
IdentityAccessRoutes --> PasswordRecovery : maps
IdentityAccessRoutes --> ResetPassword : maps
IdentityAccessRoutes --> UserAccessList : maps
IdentityAccessRoutes --> UserForm : maps
IdentityAccessRoutes --> RolePermissionForm : maps

' Asset management relationships
Asset ..> AssetStatus : uses
Asset ..> AssetType : uses
Asset ..> ConnectivityStatus : uses
Asset --> Gateway : assigned gateway
AssetSettings --> Asset : optional scope
DefaultAssetSettings ..> AssetSettings : creates
Gateway ..> GatewayStatus : uses
IoTDevice --> Asset : linked asset
IoTDevice ..> CalibrationStatus : uses
IoTDevice ..> IoTDeviceStatus : uses
IoTDevice ..> IOT_DEVICE_DEFINITIONS : configured by
AssetManagementApi --|> BaseApi
AssetManagementApi *-- BaseEndpoint
AssetAssembler ..> Asset : creates
AssetSettingsAssembler ..> AssetSettings : creates
GatewayAssembler ..> Gateway : creates
IoTDeviceAssembler ..> IoTDevice : creates
useAssetManagementStore ..> AssetManagementApi : uses
useAssetManagementStore ..> AssetAssembler : uses
useAssetManagementStore ..> AssetSettingsAssembler : uses
useAssetManagementStore ..> GatewayAssembler : uses
useAssetManagementStore ..> IoTDeviceAssembler : uses
ColdRoomList ..> useAssetManagementStore : uses
ColdRoomList ..> useIdentityAccessStore : uses
ColdRoomList --> ListPagination : uses
SafetyRangeSettings ..> useAssetManagementStore : uses
SafetyRangeSettings ..> useIdentityAccessStore : uses
SafetyRangeSettings --> ListPagination : uses
OperationalParametersSettings ..> useAssetManagementStore : uses
OperationalParametersSettings ..> useIdentityAccessStore : uses
OperationalParametersSettings --> ListPagination : uses
AssetManagementRoutes --> ColdRoomList : maps
AssetManagementRoutes --> SafetyRangeSettings : maps
AssetManagementRoutes --> OperationalParametersSettings : maps

' Monitoring relationships
SensorReading --> Asset : reading asset
SensorReading --> IoTDevice : source device
OfflineReading ..> SyncStatus : uses
MonitoringIncident --> Asset : affects
MonitoringIncident --> SensorReading : may originate from
MonitoringMaintenanceSchedule --> Asset : schedules
MonitoringTechnicalServiceRequest --> Asset : services
MonitoringApi --|> BaseApi
MonitoringApi *-- BaseEndpoint
SensorReadingAssembler ..> SensorReading : creates
MonitoringIncidentAssembler ..> MonitoringIncident : creates
MonitoringMaintenanceScheduleAssembler ..> MonitoringMaintenanceSchedule : creates
MonitoringTechnicalServiceRequestAssembler ..> MonitoringTechnicalServiceRequest : creates
useMonitoringStore ..> MonitoringApi : uses
useMonitoringStore ..> SensorReadingAssembler : uses
useMonitoringStore ..> MonitoringIncidentAssembler : uses
useMonitoringStore ..> MonitoringMaintenanceScheduleAssembler : uses
useMonitoringStore ..> MonitoringTechnicalServiceRequestAssembler : uses
useMonitoringStore ..> OfflineReading : manages
useMonitoringStore ..> Asset : reads
useMonitoringStore ..> IoTDevice : reads
OperationalDashboard ..> useMonitoringStore : uses
OperationalDashboard ..> useAssetManagementStore : uses
OperationalDashboard --> StatCard : uses
OperationalDashboard --> TemperatureChart : uses
OperationalDashboard --> StorageDistribution : uses
OperationalDashboard --> IncidentsChart : uses
OperationalDashboard --> RecentAlerts : uses
OperationalDashboard --> MaintenanceList : uses
AssetMonitoringDashboard ..> useMonitoringStore : uses
AssetMonitoringDashboard ..> useAssetManagementStore : uses
AssetMonitoringDashboard --> MonitoringAssetCard : uses
MonitoringAssetCard --> TemperatureGauge : uses
MonitoringAssetCard --> TemperatureChart : uses
MonitoringRoutes --> OperationalDashboard : maps
MonitoringRoutes --> AssetMonitoringDashboard : maps

' Alerts relationships
AlertsIncident --> Asset : affects
AlertsIncident --> SensorReading : may originate from
Notification --> AlertsIncident : references
Notification ..> NotificationChannel : uses
Notification ..> NotificationStatus : uses
