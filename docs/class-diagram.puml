package "monitoring.domain.model" {
  class DashboardKpi
  class IncidentDay
  class "Incident" as MonitoringIncident {
    - id: Number
    - organizationId: Number
    - assetId: Number
    - type: string
    - severity: string
    - status: string
    - sourceReadingId: Number
    - escalationStatus: string
    + isOpen
    + isRecognized
    + isClosed
    + isGenerated
    + isPendingReview
    + isEscalated
  }
  class "MaintenanceSchedule" as MonitoringMaintenanceSchedule
  class MaintenanceTask
  class OfflineReading {
    - id: Number
    - assetId: Number
    - iotDeviceId: Number
    - temperature: Number
    - humidity: Number
    - syncStatus: SyncStatus
